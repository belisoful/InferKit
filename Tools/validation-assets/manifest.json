  "oracle_environments": {
    "comment": "diffusers cannot be installed beside the other oracles \u2014 it needs a newer transformers than the 4.33.3 the Whisper / CLIP / SegFormer records were measured against \u2014 so the `sd_*` modes of Tools/reference-parity/run_reference.py run under their own interpreter.",
    "diffusers": {
      "path": "sdvenv",
      "create": "python3 -m venv sdvenv && ./sdvenv/bin/pip install \"diffusers==0.31.0\" \"transformers==4.46.3\" \"torch==2.8.0\" safetensors accelerate",
      "modes": [
        "sd_unet",
        "sd_vae",
        "sd_scheduler",
        "sd_text_encoder",
        "sd_tokenizer",
        "sd_text_to_image"
      ]
    },
    "llm": {
      "interpreter": "~/.inferkit-validation/llmvenv/bin/python3",
      "why": "Qwen3 needs transformers >= 4.51; the vision oracles run against 4.33.3 and the diffusers oracle against its own environment, so a third one keeps them from fighting.",
      "rebuild": "python3 -m venv ~/.inferkit-validation/llmvenv && ~/.inferkit-validation/llmvenv/bin/python3 -m pip install 'transformers>=4.51' torch safetensors",
      "modes": [
        "qwen3"
      ]
    },
    "gemma": {
      "interpreter": "~/.inferkit-validation/gemmavenv/bin/python3",
      "why": "Gemma 4 is in no released transformers, and the version that has it requires Python 3.10; this machine's system Python is 3.9.6, so Homebrew's python@3.12 was installed alongside it and this environment built on that. It also carries the deepseek_quant oracle: torch 2.13 is the first here with float8_e4m3fn and float8_e8m0fnu on the CPU, and ml_dtypes supplies float4_e2m1fn, which torch has no CPU kernel for.",
      "rebuild": "brew install python@3.12 && /opt/homebrew/opt/python@3.12/bin/python3.12 -m venv ~/.inferkit-validation/gemmavenv && ~/.inferkit-validation/gemmavenv/bin/python3 -m pip install 'git+https://github.com/huggingface/transformers.git@main' torch safetensors ml_dtypes",
      "modes": [
        "deepseek_quant",
        "gemma4",
        "qwen3_5"
      ]
    }
